# Copy to .env, edit locally, then: set -a; source .env; set +a
# .env is ignored. It is NOT loaded automatically.

# Model and rendering are independent.
SCENEQA_MODEL_BACKEND=codex
SCENEQA_MODEL=gpt-6.1-sol
SCENEQA_CODEX_AUTH=chatgpt
SCENEQA_CODEX_REASONING=xhigh
# SCENEQA_CODEX_MODEL is a legacy alias; SCENEQA_MODEL takes precedence.
# SCENEQA_CODEX_BIN=/path/to/codex
# SCENEQA_CODEX_HOME=/private/path/to/codex-home
# SCENEQA_CODEX_PORT=18773
# SCENEQA_CODEX_TIMEOUT=240
# followup / followup-batch default to 480 seconds unless explicitly overridden.

# To use another provider through Codex:
# 1. Configure it in your private Codex config.toml (see examples/).
# 2. Set the provider's env_key in your shell, outside this repository.
# SCENEQA_CODEX_AUTH=configured
# SCENEQA_CODEX_PROVIDER=sceneqa_custom
# SCENEQA_MODEL=your-vision-model
# SCENEQA_CODEX_REASONING=inherit

# Alternative: direct multimodal chat/completions, without Codex.
# SCENEQA_MODEL_BACKEND=relay
# SCENEQA_API_URL=https://your-provider.example/v1/chat/completions
# SCENEQA_API_KEY=
# SCENEQA_MODEL=your-vision-model
# Legacy aliases: LUNA_CHAT_URL, LUNA_API_KEY / LUNA_KEY_FILE, LUNA_MODEL.
# No automatic lookup of Kubernetes Secrets or fallback provider.

# Extension hook (see docs/MODEL_INTERFACE.md):
# SCENEQA_MODEL_BACKEND=plugin
# SCENEQA_MODEL_FACTORY=your_package.adapter:create_backend

# Rendering: default local child process. No kubectl or GPU requirement in Python.
SCENEQA_RENDER_BACKEND=local
SCENEQA_RENDER_THREADS=2
SCENEQA_RENDER_TIMEOUT=1800
PYOPENGL_PLATFORM=egl
# Optional local EGL device index (software devices also have an index).
# EGL_DEVICE_ID=0
# LIBGL_ALWAYS_SOFTWARE=1
# SCENEQA_RENDER_PYTHON=/path/to/render-venv/bin/python
# For OSMesa: PYOPENGL_PLATFORM=osmesa (requires Mesa/OSMesa).

# Optional remote rendering. Set these only for your own cluster.
# SCENEQA_RENDER_BACKEND=k8s
# SCENEQA_NAMESPACE=default
# SCENEQA_RENDER_IMAGE=your-registry/sceneqa-render:tag
# SCENEQA_IMAGE_PULL_SECRET=your-image-pull-secret
# SCENEQA_RENDER_GPUS=1
# SCENEQA_RENDER_CPU_REQUEST=2
# SCENEQA_RENDER_CPU_LIMIT=4
# SCENEQA_RENDER_MEMORY_REQUEST=4Gi
# SCENEQA_RENDER_MEMORY_LIMIT=10Gi

# Native-scene questions; set 0 to permit supported augmentation in the qa stage.
# followup-batch always preserves original scene objects.
SCENEQA_NATIVE_ONLY=1
SCENEQA_AUGMENT_ROUNDS=2
SCENEQA_QUESTION_SEED=0

# Historical Claude Code / Blender entry points only; not required by the GLB pipeline.
# SCENEQA_BLENDER=/path/to/blender
# TOKENHUB_API_KEY=
# SCENEQA_UPSTREAM=https://your-provider.example/v1/chat/completions
