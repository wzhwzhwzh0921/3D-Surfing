# Copy to .env, fill in locally, then load with: set -a; source .env; set +a
# .env is ignored by Git. The program does not load it automatically.

# Default provider: TokenHub OpenAI-compatible chat/completions.
TOKENHUB_API_KEY=
# Optional overrides; the TokenHub URL/model above are built-in defaults.
# SCENEQA_UPSTREAM=https://tokenhub.tencentmaas.com/v1/chat/completions
# SCENEQA_MODEL=deepseek/deepseek-flash

# Absolute path to Blender 5.x on this machine.
SCENEQA_BLENDER=/path/to/blender

# Reproducible question-type order; change for another sampling pass.
SCENEQA_QUESTION_SEED=0

# Alternative provider (use --provider deepseek). Set these instead of the
# TokenHub fields if you have an official DeepSeek API key.
# DEEPSEEK_API_KEY=
# SCENEQA_UPSTREAM=https://api.deepseek.com/anthropic
# SCENEQA_MODEL=deepseek-flash
